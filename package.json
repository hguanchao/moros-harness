{
	"name": "moros-harness",
	"version": "0.1.0",
	"description": "Local-first agent harness for the terminal and desktop.",
	"private": true,
	"author": "Moros",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"dev": "pnpm --filter @moros/terminal dev",
		"desktop:dev": "pnpm --filter @moros/desktop dev",
		"desktop:build": "pnpm --filter @moros/desktop build",
		"desktop:package": "pnpm --filter @moros/desktop package",
		"desktop:smoke": "pnpm --filter @moros/desktop smoke",
		"typecheck": "tsc --noEmit",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"check": "pnpm format:check && pnpm typecheck && pnpm test && pnpm desktop:build"
	},
	"prettier": {
		"semi": true,
		"singleQuote": false,
		"trailingComma": "all",
		"useTabs": true,
		"printWidth": 120,
		"endOfLine": "lf"
	},
	"devDependencies": {
		"@moros/core": "workspace:*",
		"@moros/desktop": "workspace:*",
		"@moros/terminal": "workspace:*",
		"@types/node": "^22.19.0",
		"prettier": "^3.6.2",
		"typescript": "~5.9.3",
		"vitest": "^3.2.4"
	}
}
